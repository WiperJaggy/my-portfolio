---
import { site } from '../data/site';

const loop = [...site.toolkit, ...site.toolkit];
---

<section class="marquee-wrap" aria-label="Technologies">
  <p class="marquee-caption container">Technologies I ship with</p>
  <div class="marquee" data-marquee>
    <div class="marquee-track">
      {loop.map((tool) => <span class="chip">{tool.name}</span>)}
    </div>
  </div>
</section>

<style>
  .marquee-wrap {
    padding: 0 0 clamp(2.5rem, 5vw, 3.5rem);
    overflow: hidden;
  }

  .marquee-caption {
    margin: 0 auto 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--neon);
  }

  .marquee {
    background: rgba(8, 18, 13, 0.55);
    padding: 0.85rem 0;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: 0.65rem;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  .chip {
    flex: 0 0 auto;
    padding: 0.4rem 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--neon-faint);
    white-space: nowrap;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: min(100% - 2rem, var(--container));
      margin-inline: auto;
      justify-content: center;
    }
  }
</style>
