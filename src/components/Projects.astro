---
import { site } from '../data/site';
---

<section class="section projects" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="projects-head reveal">
      <p class="section-label">Projects</p>
      <h2 class="section-title" id="projects-title">Work that ships — and stays fast.</h2>
      <p class="section-lead">
        Selected work spanning Astro builds, SEO care, CI/CD pipelines, and interactive UI.
        <a href="/work">Browse the full site list →</a>
      </p>
    </div>

    <ul class="project-grid">
      {
        site.projects.map((project, i) => (
          <li class={`project neon-frame reveal reveal-delay-${(i % 3) + 1}`}>
            <div class="project-top">
              <span class="project-status">{project.status}</span>
              <a class="project-link" href={project.href} aria-label={`Inquire about ${project.title}`}>
                →
              </a>
            </div>
            <h3 class="project-title">{project.title}</h3>
            <p class="project-desc">{project.description}</p>
            <ul class="project-tags">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .projects-head {
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
  }

  .project-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .project {
    padding: 1.35rem 1.25rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 100%;
  }

  .project:hover {
    transform: translateY(-4px);
  }

  .project-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-status {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--neon);
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--neon-faint);
  }

  .project-link {
    width: 2.25rem;
    height: 2.25rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--neon);
    font-size: 1.1rem;
    transition: background 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out),
      transform 0.25s var(--ease-out);
  }

  .project:hover .project-link {
    background: var(--neon-faint);
    box-shadow: 0 0 18px var(--neon-dim);
    transform: rotate(-35deg);
  }

  .project-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .project-desc {
    margin: 0;
    color: var(--text-muted);
    flex: 1;
  }

  .project-tags {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-tags li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    padding: 0.28rem 0.5rem;
    border: 1px solid rgba(124, 255, 178, 0.12);
    border-radius: var(--radius);
  }

  @media (max-width: 720px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
