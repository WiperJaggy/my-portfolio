---
import { site } from '../data/site';

const featured = site.featuredWork
  .map((slug) => site.work.find((item) => item.slug === slug))
  .filter((item): item is (typeof site.work)[number] => Boolean(item));
---

<section class="section featured" id="featured" aria-labelledby="featured-title">
  <div class="container">
    <div class="featured-head reveal">
      <p class="section-label">Selected work</p>
      <h2 class="section-title" id="featured-title">Live sites. Measured where it counts.</h2>
      <p class="section-lead">
        A few shipped projects with performance, SEO, and accessibility scores where audited.
      </p>
    </div>

    <ul class="featured-grid">
      {
        featured.map((item, i) => (
          <li class={`neon-frame featured-card reveal reveal-delay-${(i % 3) + 1}`}>
            <a class="featured-media" href={item.url} target="_blank" rel="noopener noreferrer">
              <img src={item.image} alt={`${item.title} preview`} width="640" height="360" loading="lazy" />
              <span class="stack-badge">{item.stack === 'wordpress' ? 'WordPress' : 'Astro'}</span>
            </a>
            <div class="featured-body">
              <div class="featured-meta">
                <h3>
                  <a href={item.url} target="_blank" rel="noopener noreferrer">
                    {item.title}
                  </a>
                </h3>
                {'year' in item && item.year ? <span>{item.year}</span> : null}
              </div>
              <p>{item.description}</p>
              {'scores' in item && item.scores ? (
                <ul class="scores" aria-label="Lighthouse-style scores">
                  <li>
                    <strong>{item.scores.performance}</strong>
                    <span>perf</span>
                  </li>
                  <li>
                    <strong>{item.scores.seo}</strong>
                    <span>seo</span>
                  </li>
                  <li>
                    <strong>{item.scores.accessibility}</strong>
                    <span>a11y</span>
                  </li>
                </ul>
              ) : (
                <p class="score-pending">Scores available after PageSpeed audit</p>
              )}
            </div>
          </li>
        ))
      }
    </ul>

    <div class="featured-cta reveal">
      <a class="btn btn-primary" href="/work">View all projects</a>
    </div>
  </div>
</section>

<style>
  .featured-head {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
  }

  .featured-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .featured-card {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .featured-card:hover {
    transform: translateY(-4px);
  }

  .featured-media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }

  .featured-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 0.4s var(--ease-out);
  }

  .featured-card:hover .featured-media img {
    transform: scale(1.04);
  }

  .stack-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.28rem 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--neon);
    background: rgba(5, 8, 7, 0.85);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .featured-body {
    padding: 1.1rem 1.15rem 1.2rem;
    display: grid;
    gap: 0.65rem;
    flex: 1;
  }

  .featured-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }

  .featured-meta h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.2rem;
  }

  .featured-meta h3 a {
    color: var(--text);
  }

  .featured-meta h3 a:hover {
    color: var(--neon);
  }

  .featured-meta span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-dim);
  }

  .featured-body > p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .scores {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .scores li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--neon-faint);
  }

  .scores strong {
    font-family: var(--font-display);
    color: var(--neon);
    font-size: 0.95rem;
  }

  .scores span {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .score-pending {
    margin: 0.25rem 0 0 !important;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-dim) !important;
  }

  .featured-cta {
    margin-top: 1.5rem;
  }

  @media (max-width: 760px) {
    .featured-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
