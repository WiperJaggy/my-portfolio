---
import { site } from '../data/site';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const socials = [
  { label: 'GitHub', href: site.socials.github, icon: 'github' },
  { label: 'GitLab', href: site.socials.gitlab, icon: 'gitlab' },
  { label: 'LinkedIn', href: site.socials.linkedin, icon: 'linkedin' },
  { label: 'WhatsApp', href: site.socials.whatsapp, icon: 'whatsapp' },
] as const;
---

<nav class:list={['social-icons', className]} aria-label="Social links">
  {
    socials.map((item) => (
      <a
        class="social-link"
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={item.label}
        title={item.label}
      >
        {item.icon === 'github' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2C6.477 2 2 6.486 2 12.021c0 4.425 2.865 8.18 6.839 9.504.5.093.682-.217.682-.483 0-.237-.009-.866-.013-1.7-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.467-1.11-1.467-.908-.622.069-.609.069-.609 1.004.071 1.532 1.034 1.532 1.034.892 1.532 2.341 1.089 2.91.833.091-.647.35-1.089.636-1.34-2.221-.254-4.555-1.113-4.555-4.952 0-1.094.39-1.989 1.029-2.689-.103-.254-.446-1.274.098-2.656 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.026 2.747-1.026.546 1.382.202 2.402.1 2.656.64.7 1.028 1.595 1.028 2.689 0 3.848-2.338 4.695-4.566 4.944.359.31.678.922.678 1.858 0 1.34-.012 2.42-.012 2.75 0 .268.18.58.688.482A10.025 10.025 0 0 0 22 12.021C22 6.486 17.523 2 12 2Z"
            />
          </svg>
        )}
        {item.icon === 'gitlab' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M22.65 14.39 12 22.13 1.35 14.39a.84.84 0 0 1-.3-.94l1.22-3.78 2.44-7.51A.42.42 0 0 1 5.5 2a.41.41 0 0 1 .4.28l2.37 7.3h7.46l2.37-7.3a.41.41 0 0 1 .4-.28.42.42 0 0 1 .4.28l2.44 7.51 1.22 3.78a.84.84 0 0 1-.31.94Z"
            />
          </svg>
        )}
        {item.icon === 'linkedin' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0Z"
            />
          </svg>
        )}
        {item.icon === 'whatsapp' && (
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35ZM12.05 21.8h-.01a9.8 9.8 0 0 1-4.98-1.36l-.36-.21-3.7.97 1-3.61-.24-.37a9.76 9.76 0 0 1-1.5-5.21c0-5.4 4.4-9.8 9.82-9.8a9.75 9.75 0 0 1 9.8 9.8c0 5.41-4.4 9.8-9.81 9.8Zm8.32-18.12A11.74 11.74 0 0 0 12.04 0C5.45 0 .1 5.35.1 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.27-1.64a11.9 11.9 0 0 0 5.77 1.47h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.18-3.5-8.42Z"
            />
          </svg>
        )}
      </a>
    ))
  }
</nav>

<style>
  .social-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }

  .social-link {
    width: 2.45rem;
    height: 2.45rem;
    display: grid;
    place-items: center;
    color: var(--neon);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--neon-faint);
    box-shadow: 0 0 14px var(--neon-faint);
    transition: transform 0.25s var(--ease-out), border-color 0.25s var(--ease-out),
      box-shadow 0.25s var(--ease-out), background 0.25s var(--ease-out);
  }

  .social-link:hover {
    color: var(--neon-soft);
    border-color: var(--border-strong);
    background: rgba(124, 255, 178, 0.14);
    box-shadow: 0 0 22px var(--neon-dim);
    transform: translateY(-2px);
  }

  .social-link svg {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
  }
</style>
