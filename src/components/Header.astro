---
import { site } from '../data/site';

const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname;
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="logo" href="/" aria-label={`${site.name} home`}>
      <span class="logo-mark" aria-hidden="true"></span>
      <span class="logo-text">{site.name}</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav class="site-nav" id="site-nav" data-nav aria-label="Primary">
      <ul>
        {
          links.map((link) => {
            const active =
              link.href === '/'
                ? pathname === '/' || pathname === ''
                : pathname === link.href || pathname === `${link.href}/`;
            return (
              <li>
                <a href={link.href} aria-current={active ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <a
        class="btn btn-primary header-cta"
        href={site.socials.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Hire me on WhatsApp"
      >
        <svg class="cta-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.48-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.48.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35ZM12.05 21.8h-.01a9.8 9.8 0 0 1-4.98-1.36l-.36-.21-3.7.97 1-3.61-.24-.37a9.76 9.76 0 0 1-1.5-5.21c0-5.4 4.4-9.8 9.82-9.8a9.75 9.75 0 0 1 9.8 9.8c0 5.41-4.4 9.8-9.81 9.8Zm8.32-18.12A11.74 11.74 0 0 0 12.04 0C5.45 0 .1 5.35.1 11.93c0 2.1.55 4.15 1.6 5.96L0 24l6.27-1.64a11.9 11.9 0 0 0 5.77 1.47h.01c6.58 0 11.93-5.35 11.93-11.93 0-3.19-1.24-6.18-3.5-8.42Z"
          />
        </svg>
        Hire me
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: rgba(5, 8, 7, 0.55);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease-out), background 0.3s var(--ease-out);
  }

  .site-header.is-scrolled {
    background: rgba(5, 8, 7, 0.88);
    border-bottom-color: var(--border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.35);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(100% - 2rem, var(--container));
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .logo:hover {
    color: var(--neon-soft);
  }

  .logo-mark {
    width: 1.35rem;
    height: 1.35rem;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    background: linear-gradient(145deg, var(--neon), transparent 65%);
    box-shadow: 0 0 16px var(--neon-dim);
    animation: pulse-glow 3s ease-in-out infinite;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-nav ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 0.25rem 1.35rem;
  }

  .site-nav a:not(.btn) {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-nav a:not(.btn):hover,
  .site-nav a:not(.btn)[aria-current='page'] {
    color: var(--neon);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-panel);
    cursor: pointer;
  }

  .nav-toggle span {
    display: block;
    width: 1.1rem;
    height: 2px;
    margin-inline: auto;
    background: var(--neon);
    transition: transform 0.25s var(--ease-out), opacity 0.2s;
  }

  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1.25rem 1rem 1.5rem;
      background: rgba(5, 8, 7, 0.96);
      border-bottom: 1px solid var(--border);
      transform: translateY(-120%);
      opacity: 0;
      pointer-events: none;
      transition: transform 0.35s var(--ease-out), opacity 0.35s var(--ease-out);
    }

    .site-nav.is-open {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }

    .site-nav ul {
      flex-direction: column;
      gap: 0;
    }

    .site-nav ul a {
      display: block;
      padding: 0.85rem 0.5rem;
      border-bottom: 1px solid var(--neon-faint);
    }

    .header-cta {
      width: 100%;
    }
  }

  .header-cta {
    gap: 0.45rem;
  }

  .cta-icon {
    width: 1rem;
    height: 1rem;
    display: block;
    flex-shrink: 0;
  }
</style>
