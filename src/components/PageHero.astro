---
interface Props {
  label: string;
  title: string;
  lead?: string;
  animated?: boolean;
}

const { label, title, lead, animated = false } = Astro.props;
---

<header class="page-hero">
  <div class="container">
    <p class="section-label reveal">{label}</p>
    <h1 class:list={['page-title', 'reveal', 'reveal-delay-1', { 'is-animated': animated }]} set:html={title} />
    {lead && <p class="section-lead reveal reveal-delay-2">{lead}</p>}
  </div>
</header>

<style>
  .page-hero {
    padding: clamp(2.5rem, 6vw, 4rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .page-title {
    margin: 0 0 0.85rem;
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    color: var(--text);
  }

  .page-title.is-animated {
    background: linear-gradient(120deg, var(--text) 35%, var(--neon) 55%, var(--text) 75%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shimmer 4.5s ease-in-out infinite;
  }

  .page-title :global(em) {
    font-style: normal;
    color: var(--neon);
  }

  .page-title.is-animated :global(em) {
    color: inherit;
  }

  @keyframes shimmer {
    0%,
    100% {
      background-position: 0% center;
    }
    50% {
      background-position: 100% center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-title.is-animated {
      animation: none;
      color: var(--text);
      background: none;
      -webkit-background-clip: unset;
      background-clip: unset;
    }

    .page-title.is-animated :global(em) {
      color: var(--neon);
    }
  }
</style>
